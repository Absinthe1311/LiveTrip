# ============================================
# LiveTrip Frontend 环境变量配置示例
# ============================================
# 请复制此文件为 .env 并填入真实值

# API 配置
VITE_API_BASE_URL=http://localhost:3001

# 高德地图 API 配置
# 前往 https://console.amap.com/dev/key/app 注册申请
VITE_AMAP_JS_KEY=your-amap-js-key-here
VITE_AMAP_JS_SECRET=your-amap-js-secret-here

# 智谱AI 配置（用于AI行程规划）
# 前往 https://open.bigmodel.cn/ 获取 API Key
VITE_ZHIPUAI_API_KEY=your-zhipuai-api-key-here
