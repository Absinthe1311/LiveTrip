# ============================================
# LiveTrip Frontend 环境变量配置示例
# ============================================
# 请复制此文件为 .env 并填入真实值

# API 配置
VITE_API_BASE_URL=http://localhost:3001/api
VITE_SOCKET_URL=http://localhost:3001

# 高德地图 API 配置
# 前往 https://console.amap.com/dev/key/app 注册申请
# Web服务API Key（用于定位、搜索等功能）
VITE_AMAP_WS_KEY=your-amap-web-service-key-here
# Web端JS API Key（用于地图显示功能）
VITE_AMAP_JS_KEY=your-amap-js-key-here
# Web端JS API 安全密钥
VITE_AMAP_JS_SECRET=your-amap-js-secret-here
