# 数据库配置
DATABASE_URL="postgresql://username:password@localhost:5432/livetrip?schema=public"

# 服务器配置
PORT=3000
NODE_ENV=development

# JWT 配置（可选）
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# AI 服务配置（可选）
AI_API_KEY=your-ai-api-key
AI_API_URL=https://api.example.com

# 高德地图 API 配置
# 前往 https://console.amap.com/dev/key/app 注册申请
AMAP_API_KEY=your-amap-key-here

# Anthropic Claude API 配置（用于AI推荐）
# 前往 https://console.anthropic.com/ 获取 API Key
ANTHROPIC_API_KEY=your-claude-api-key-here

# OpenAI API 配置（备选AI服务）
# 前往 https://platform.openai.com/api-keys 获取 API Key
OPENAI_API_KEY=your-openai-api-key-here

# CORS 配置
CORS_ORIGIN=http://localhost:5173
