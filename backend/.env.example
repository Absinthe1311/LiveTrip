# ============================================
# LiveTrip Backend 环境变量配置示例
# ============================================
# 请复制此文件为 .env 并填入真实值

# 数据库配置
DATABASE_URL="file:./dev.db"

# 服务器配置
PORT=3001
NODE_ENV=development

# JWT 配置
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# 智谱AI 配置（用于AI行程规划）
# 前往 https://open.bigmodel.cn/ 获取 API Key
ZHIPUAI_API_KEY=your-zhipuai-api-key-here

# 高德地图 API 配置
# 前往 https://console.amap.com/dev/key/app 注册申请
# Web服务API Key（用于后端地理编码、路径规划等）
AMAP_API_KEY=your-amap-web-service-key-here

# Cloudinary 配置（图片存储服务）
# 前往 https://cloudinary.com/ 获取配置信息
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# OpenWeatherMap 天气数据配置
# 前往 https://openweathermap.org/api 获取 API Key
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key-here
OPENWEATHERMAP_API_URL=https://api.openweathermap.org/data/2.5

# CORS 配置
# 支持多个来源，用逗号分隔
# 示例：CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://yourdomain.com
CORS_ORIGIN=http://localhost:5173

# 前端URL配置（用于生成分享链接、协同邀请链接等）
FRONTEND_URL=http://localhost:5173
