{
  "name": "livetrip-backend",
  "version": "1.0.0",
  "description": "AI + IoT Smart Travel Planning System Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test:db": "ts-node scripts/test-db-connection.ts",
    "backup:db": "ts-node scripts/backup-db.ts",
    "restore:db": "ts-node scripts/restore-db.ts",
    "upload:spot-images": "ts-node scripts/batch-upload-spot-images.ts",
    "lint": "eslint src",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "travel",
    "ai",
    "iot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "6.1.0",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "cors": "2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-validator": "7.2.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.2",
    "morgan": "1.10.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "22.10.2",
    "eslint": "9.17.0",
    "nodemon": "3.1.9",
    "prettier": "3.4.2",
    "prisma": "6.1.0",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  }
}
