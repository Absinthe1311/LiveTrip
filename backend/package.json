    "morgan": "1.10.0",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "redis": "4.7.0",
    "express-validator": "7.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/cors": "2.8.17",
    "@types/morgan": "1.9.9",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.7",
    "@types/node": "22.10.2",
    "typescript": "5.7.3",
    "prisma": "6.1.0",
    "ts-node": "10.9.2",
    "nodemon": "3.1.9",
