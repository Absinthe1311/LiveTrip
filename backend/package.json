  "description": "AI + IoT Smart Travel Planning System Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "test:db": "ts-node scripts/test-db-connection.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "travel",
    "ai",
    "iot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@prisma/client": "6.1.0",
    "axios": "^1.13.4",
    "bcryptjs": "^3.0.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-validator": "7.2.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "1.10.0",
    "openai": "^6.17.0",
    "redis": "4.7.0",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "1.9.9",
    "@types/node": "22.10.2",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.7",
    "eslint": "9.17.0",
    "nodemon": "3.1.9",
    "prettier": "3.4.2",
    "prisma": "6.1.0",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  }
