generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(cuid())
  username            String           @unique
  email               String?          @unique
  passwordHash        String
  avatar              String?          @default("")
  nickname            String?          @default("")
  gender              String?          @default("")
  bio                 String?          @default("")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  role                String           @default("user")
  // 统计字段
  totalTrips          Int              @default(0)
  totalCities         Int              @default(0)
  completedTrips      Int              @default(0)
  reviewedBlogs       BlogPost[]       @relation("BlogReviewer")
  blogs               BlogPost[]       @relation("BlogAuthor")
  blogComments        BlogComment[]
  collabMessages      CollabMessage[]
  collabRoomsAsHost   CollabRoom[]     @relation("HostRooms")
  draftRoutes         DraftRoute[]
  uploadedImages      SpotImage[]      @relation("ImageUploader")
  reviewedImages      SpotImage[]      @relation("ImageReviewer")
  trips               Trip[]
  collabRoomsAsMember TripMember[]
  notifications       Notification[]
}

model Trip {
  id                        String        @id @default(cuid())
  userId                    String
  title                     String
  description               String?       @default("")
  coverImage                String?       @default("")
  destination               String
  startDate                 DateTime
  endDate                   DateTime
  status                    String        @default("planning")
  completedAt               DateTime?
  totalBudget               Float         @default(0)
  aiGenerated               Boolean       @default(true)
  source                    String        @default("personal")
  hotelName                 String?
  hotelAddress              String?
  hotelLocation             String?
  hotelTel                  String?
  hotelType                 String?
  hotelRating               Float?
  actualBudget              Float         @default(0)
  budgetStatus              String        @default("under_budget")
  remainingBudget           Float         @default(0)  // 剩余预算
  isPublic                  Boolean       @default(false)
  shareToken                String?       @unique
  hotelRecommendationsCache String?       @default("")
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  budget                    Budget?
  collabRoom                CollabRoom?
  days                      Day[]
  packingItems              PackingItem[]
  budgetRecords             BudgetRecord[]
  user                      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PackingItem {
  id          String   @id @default(cuid())
  tripId      String
  itemName    String
  category    String
  isPacked    Boolean  @default(false)
  isSuggested Boolean  @default(false)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([category])
}

model Day {
  id                             String          @id @default(cuid())
  tripId                         String
  dayNumber                      Int
  date                           DateTime
  notes                          String?         @default("")
  createdAt                      DateTime        @default(now())
  updatedAt                      DateTime        @updatedAt
  restaurantAddress              String?
  restaurantLocation             String?
  restaurantName                 String?
  restaurantRating               Float?
  restaurantTel                  String?
  restaurantType                 String?
  restaurantRecommendationsCache String?         @default("")
  trip                           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  itineraryItems                 ItineraryItem[]
}

model ItineraryItem {
  id          String   @id @default(cuid())
  dayId       String
  name        String
  type        String
  category    String?  @default("")
  description String?  @default("")
  startTime   DateTime
  endTime     DateTime
  address     String?  @default("")
  latitude    Float?
  longitude   Float?
  cost        Float    @default(0)
  spotId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  spot        Spot?    @relation(fields: [spotId], references: [id])
  day         Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([spotId])
}

model Budget {
  id             String   @id @default(cuid())
  tripId         String   @unique
  transportation Float    @default(0)
  accommodation  Float    @default(0)
  food           Float    @default(0)
  tickets        Float    @default(0)
  shopping       Float    @default(0)
  other          Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// AI辅助生成：GLM-5, 2026-04-24 21:31
// 描述：预算变更记录表，用于追踪预算调整历史，支持预算功能的实时更新和记录追踪
model BudgetRecord {
  id              String   @id @default(cuid())
  tripId          String

  // 变更类型
  changeType      String   // 'total_budget_adjusted', 'item_price_updated', 'hotel_selected', 'restaurant_selected', 'attraction_added', 'attraction_removed'
  category        String?  // 'transportation', 'accommodation', 'dining', 'tickets', 'shopping', 'other'

  // 变更详情
  previousAmount  Float    // 变更前金额
  newAmount       Float    // 变更后金额
  difference      Float    // 差额

  // 描述信息
  description     String   // 变更描述
  relatedItemName String?  // 关联项目名称

  // 预算快照
  totalBudget     Float    // 当时的总预算
  usedBudget      Float    // 当时的已用预算
  remainingBudget Float    // 当时的剩余预算

  createdAt       DateTime @default(now())

  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([createdAt])
}

model AmapPOICache {
  id         String   @id @default(cuid())
  poiId      String   @unique
  name       String
  type       String
  typecode   String
  address    String?
  location   String
  tel        String?
  distance   String?
  rating     Float?
  cost       String?
  city       String
  cacheTime  DateTime @default(now())
  expireTime DateTime
  hitCount   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model LocationCache {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("location")
  category    String?
  address     String?
  city        String?
  province    String?
  latitude    Float?
  longitude   Float?
  keywords    String
  searchCount Int      @default(1)
  cacheTime   DateTime @default(now())
  expireTime  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([keywords])
  @@index([name])
}

model Spot {
  id             String          @id @default(cuid())
  amapId         String          @unique
  name           String
  location       String
  address        String?
  city           String
  category       String?
  ticketPrice    Float?          @default(0)
  openTime       String?
  rating         Float?
  description    String?
  isOutdoor      Boolean?        @default(true)
  isHot          Boolean         @default(false)
  source         String          @default("amap")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  favorites      Favorite[]
  itineraryItems ItineraryItem[]
  image          SpotImage?
  iotData        SpotIoTData?

  @@index([city])
  @@index([category])
  @@index([amapId])
  @@index([name])
  @@index([name, city])
}

model SpotIoTData {
  id                 String    @id @default(cuid())
  spotId             String    @unique
  crowdLevel         Float
  temperature        Float
  rainProbability    Float
  isOpen             Boolean
  generatedAt        DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  weatherDescription String?   @default("")
  weatherIcon        String?   @default("")
  weatherUpdatedAt   DateTime?
  spot               Spot      @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@index([spotId])
  @@index([generatedAt])
}

model SpotImage {
  id          String    @id @default(cuid())
  spotId      String    @unique
  url         String
  source      String    @default("admin")
  uploadedBy  String
  status      String    @default("approved")  // approved/pending/rejected
  isPrimary   Boolean   @default(false)
  priority    Int       @default(0)
  fileHash    String?
  viewCount   Int       @default(0)
  likeCount   Int       @default(0)
  reportCount Int       @default(0)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  uploader    User      @relation("ImageUploader", fields: [uploadedBy], references: [id])
  spot        Spot      @relation(fields: [spotId], references: [id], onDelete: Cascade)
  reviewer    User?     @relation("ImageReviewer", fields: [reviewedBy], references: [id])

  @@index([spotId])
  @@index([source])
  @@index([status])
}

model SpotAlternative {
  id                String   @id @default(cuid())
  originalSpotId    String
  alternativeSpotId String
  city              String
  priority          Int      @default(0)
  createdAt         DateTime @default(now())

  @@unique([originalSpotId, alternativeSpotId])
  @@index([originalSpotId])
  @@index([alternativeSpotId])
  @@index([city])
}

model Favorite {
  id        String   @id @default(cuid())
  spotId    String
  userId    String   @default("default-user")
  notes     String?  @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  spot      Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@unique([spotId, userId])
  @@index([userId])
  @@index([spotId])
}

model DestinationCache {
  id          String   @id @default(cuid())
  city        String   @unique
  attractions String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([city])
  @@index([expiresAt])
}

model BlogPost {
  id           String        @id @default(cuid())
  userId       String
  title        String
  content      String
  coverImage   String?
  tags         String
  city         String?
  spotIds      String?
  imageIds     String?
  viewCount    Int           @default(0)
  likeCount    Int           @default(0)
  commentCount Int           @default(0)
  isPublished  Boolean       @default(false)
  publishedAt  DateTime?
  status       String        @default("pending")
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  comments     BlogComment[]
  likes        BlogLike[]
  author       User          @relation("BlogAuthor", fields: [userId], references: [id])
  reviewer     User?         @relation("BlogReviewer", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([city])
  @@index([isPublished])
  @@index([publishedAt])
  @@index([status])
}

model BlogComment {
  id        String            @id @default(cuid())
  postId    String
  userId    String
  content   String
  likeCount Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  post      BlogPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     BlogCommentLike[]

  @@index([postId])
  @@index([userId])
  @@index([createdAt])
  @@index([likeCount])
}

model BlogCommentLike {
  id        String      @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime    @default(now())
  comment   BlogComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model BlogLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Hotel {
  id        String   @id @default(cuid())
  amapId    String   @unique
  name      String
  address   String?
  location  String
  tel       String?
  type      String
  rating    Float?
  city      String
  hitCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([location])
}

model Restaurant {
  id        String   @id @default(cuid())
  amapId    String   @unique
  name      String
  address   String?
  location  String
  tel       String?
  type      String
  rating    Float?
  city      String
  hitCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([location])
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String?
  mode      String
  state     String        @default("idle")        // ✅ P0优化: 会话状态 (idle/waiting/completed)
  tempData  String?       @default("")            // ✅ P0优化: 临时数据（JSON格式，用于二次确认）
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId])
  @@index([mode])
  @@index([state])        // ✅ P0优化: 添加状态索引
  @@index([createdAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      String
  content   String
  toolCall  String?     @default("")
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([role])
  @@index([createdAt])
}

model CollabRoom {
  id              String          @id @default(cuid())
  tripId          String          @unique
  hostId          String
  phase           String          @default("EDITING")
  inviteToken     String          @unique
  inviteExpiresAt DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  messages        CollabMessage[]
  host            User            @relation("HostRooms", fields: [hostId], references: [id], onDelete: Cascade)
  trip            Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  drafts          DraftRoute[]
  members         TripMember[]

  @@index([hostId])
  @@index([inviteToken])
}

model TripMember {
  id           String     @id @default(cuid())
  roomId       String
  userId       String
  role         String     @default("COLLABORATOR")
  assignedDays String     @default("[]")
  joinedAt     DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  room         CollabRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model DraftRoute {
  id           String     @id @default(cuid())
  roomId       String
  userId       String
  dayNumber    Int
  spotSequence String
  polylineData String
  isSubmitted  Boolean    @default(false)
  version      Int        @default(1)
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  room         CollabRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId, dayNumber])
  @@index([roomId])
  @@index([userId])
  @@index([dayNumber])
}

model CollabMessage {
  id        String     @id @default(cuid())
  roomId    String
  userId    String
  content   String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      CollabRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@index([createdAt])
}

// 站内通知表
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 通知类型: sensor, system
  type      String

  // 通知标题
  title     String

  // 通知内容
  content   String

  // 关联数据（JSON格式）
  data      String?  @default("{}")

  // 是否已读
  isRead    Boolean  @default(false)

  // 阅读时间
  readAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

// 环境传感器日志表
model EnvironmentSensorLog {
  id             String   @id @default(cuid())
  spotId         String
  crowdLevel     Float
  temperature    Float
  rainProbability Float
  isOpen         Boolean
  weatherDescription String?
  weatherIcon    String?
  generatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([spotId])
  @@index([generatedAt])
}
