// LiveTrip Database Schema - Optimized Version
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Table
model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String?   @unique
  passwordHash  String
  avatar        String?   @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  trips         Trip[]
  preferences   UserPreferences?
}

// User Preferences Table
model UserPreferences {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Travel preferences
  travelStyle     String   @default("balanced")
  budgetRange     String   @default("medium")
  accommodation   String   @default("hotel")
  transportation  String   @default("mixed")
  
  // Dietary preferences
  dietaryPrefs    String   @default("")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Trip Table
model Trip {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Basic info
  title           String
  description     String?   @default("")
  destination     String
  startDate       DateTime
  endDate         DateTime
  status          String    @default("planning")
  
  // Budget info
  totalBudget     Float     @default(0)
  
  // AI generation info
  aiGenerated     Boolean   @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  days            Day[]
  budget          Budget?
}

// Day Table
model Day {
  id              String    @id @default(cuid())
  tripId          String
  trip            Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  
  dayNumber       Int
  date            DateTime
  notes           String?   @default("")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  itineraryItems  ItineraryItem[]
}

// Itinerary Item Table
model ItineraryItem {
  id              String    @id @default(cuid())
  dayId           String
  day             Day       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  
  // Basic info
  name            String
  type            String
  category        String?   @default("")
  description     String?   @default("")
  
  // Time info
  startTime       DateTime
  endTime         DateTime
  
  // Location info
  address         String?   @default("")
  latitude        Float?
  longitude       Float?
  
  // Cost info
  cost            Float     @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Budget Table
model Budget {
  id              String   @id @default(cuid())
  tripId          String   @unique
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  
  // Budget items
  transportation  Float    @default(0)
  accommodation   Float    @default(0)
  food            Float    @default(0)
  tickets         Float    @default(0)
  shopping        Float    @default(0)
  other           Float    @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Amap POI Cache Table - 用于缓存高德地图的景点数据
model AmapPOICache {
  id              String   @id @default(cuid())
  
  // POI info from Amap
  poiId           String   @unique
  name            String
  type            String
  typecode        String
  address         String?
  location        String   // 经纬度 "116.397428,39.90923"
  tel             String?
  distance        String?
  
  // Extended info
  rating          Float?
  cost            String?
  
  // City info (for grouping and caching)
  city            String
  
  // Cache info
  cacheTime       DateTime @default(now())
  expireTime      DateTime
  
  // Usage statistics
  hitCount        Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Location Cache Table - 用于缓存用户搜索过的地点
model LocationCache {
  id              String   @id @default(cuid())
  
  // Location info
  name            String
  type            String   @default("location")
  category        String?
  address         String?
  city            String?
  province        String?
  
  // Location coordinates
  latitude        Float?
  longitude       Float?
  
  // Search info
  keywords        String   // 用户搜索的关键词
  searchCount     Int      @default(1) // 搜索次数
  
  // Cache info
  cacheTime       DateTime @default(now())
  expireTime      DateTime @default(now()) // 默认7天后过期
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([keywords])
  @@index([name])
}
