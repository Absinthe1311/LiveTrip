// LiveTrip Database Schema - Optimized Version
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Table
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  avatar       String?  @default("")
  role         String   @default("user") // 'admin', 'user'
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  trips           Trip[]
  preferences     UserPreferences?
  uploadedImages  SpotImage[] @relation("ImageUploader")
  reviewedImages  SpotImage[] @relation("ImageReviewer")
  reviewedBlogs   BlogPost[] @relation("BlogReviewer")
}

// User Preferences Table
model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Travel preferences
  travelStyle    String @default("balanced")
  budgetRange    String @default("medium")
  accommodation  String @default("hotel")
  transportation String @default("mixed")

  // Dietary preferences
  dietaryPrefs String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Trip Table
model Trip {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Basic info
  title       String
  description String?  @default("")
  destination String
  startDate   DateTime
  endDate     DateTime
  status      String   @default("planning")
  completedAt DateTime? // 行程完成时间

  // Budget info
  totalBudget Float @default(0)

  // AI generation info
  aiGenerated Boolean @default(true)

  // Hotel info (选中的酒店)
  hotelName     String?
  hotelAddress  String?
  hotelLocation String?
  hotelTel      String?
  hotelType     String?
  hotelRating   Float?

  // Budget tracking
  actualBudget Float  @default(0) // 实际总开销
  budgetStatus String @default("under_budget") // under_budget, on_budget, over_budget

  // Share info (分享相关字段)
  isPublic   Boolean @default(false) // 是否公开分享
  shareToken String? @unique // 分享token(8-12位随机字符串)

  // Hotel recommendations cache (酒店推荐缓存)
  hotelRecommendationsCache String? @default("") // JSON字符串,存储推荐的酒店列表

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  days         Day[]
  budget       Budget?
  packingItems PackingItem[]
}

// Packing Item Table - 打包清单表
model PackingItem {
  id          String   @id @default(cuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  itemName    String   // 物品名称
  category    String   // 分类：clothing, electronics, documents, toiletries, medicine, other
  isPacked    Boolean  @default(false)  // 是否已打包
  isSuggested Boolean  @default(false)  // 是否为AI建议
  isDefault   Boolean  @default(false)  // 是否为默认预设项

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tripId])
  @@index([category])
}

// Day Table
model Day {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  dayNumber Int
  date      DateTime
  notes     String?  @default("")

  // Restaurant info (选中的餐厅 - 午餐)
  restaurantName     String?
  restaurantAddress  String?
  restaurantLocation String?
  restaurantTel      String?
  restaurantType     String?
  restaurantRating   Float?

  // Restaurant recommendations cache (餐厅推荐缓存)
  restaurantRecommendationsCache String? @default("") // JSON字符串,存储推荐的餐厅列表

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  itineraryItems ItineraryItem[]
}

// Itinerary Item Table
model ItineraryItem {
  id    String @id @default(cuid())
  dayId String
  day   Day    @relation(fields: [dayId], references: [id], onDelete: Cascade)

  // Basic info
  name        String
  type        String
  category    String? @default("")
  description String? @default("")

  // Time info
  startTime DateTime
  endTime   DateTime

  // Location info
  address   String? @default("")
  latitude  Float?
  longitude Float?

  // Cost info
  cost Float @default(0)

  // Spot relation (optional, for image upload)
  spotId String?
  spot   Spot?  @relation(fields: [spotId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spotId])
}

// Budget Table
model Budget {
  id     String @id @default(cuid())
  tripId String @unique
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // Budget items
  transportation Float @default(0)
  accommodation  Float @default(0)
  food           Float @default(0)
  tickets        Float @default(0)
  shopping       Float @default(0)
  other          Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Amap POI Cache Table - 用于缓存高德地图的景点数据
model AmapPOICache {
  id String @id @default(cuid())

  // POI info from Amap
  poiId    String  @unique
  name     String
  type     String
  typecode String
  address  String?
  location String // 经纬度 "116.397428,39.90923"
  tel      String?
  distance String?

  // Extended info
  rating Float?
  cost   String?

  // City info (for grouping and caching)
  city String

  // Cache info
  cacheTime  DateTime @default(now())
  expireTime DateTime

  // Usage statistics
  hitCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Location Cache Table - 用于缓存用户搜索过的地点
model LocationCache {
  id String @id @default(cuid())

  // Location info
  name     String
  type     String  @default("location")
  category String?
  address  String?
  city     String?
  province String?

  // Location coordinates
  latitude  Float?
  longitude Float?

  // Search info
  keywords    String // 用户搜索的关键词
  searchCount Int    @default(1) // 搜索次数

  // Cache info
  cacheTime  DateTime @default(now())
  expireTime DateTime @default(now()) // 默认7天后过期

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([keywords])
  @@index([name])
}

// Spot Table - 景点表（从高德API获取并存储）
model Spot {
  id String @id @default(cuid())

  // POI info from Amap
  amapId   String  @unique
  name     String
  location String // 经纬度 "116.397428,39.90923"
  address  String?
  city     String
  category String? // 景点分类

  // Extended info
  ticketPrice Float?   @default(0)
  openTime    String?
  rating      Float?
  description String?
  isOutdoor   Boolean? @default(true)
  isHot       Boolean  @default(false) // 是否为热门景点

  // 图片相关字段
  coverImage  String?  // 主要图片URL
  avgRating   Float?   // 平均评分
  reviewCount Int      @default(0) // 评价数量

  // Metadata
  source    String   @default("amap") // 'amap', 'user_contributed'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  iotData        SpotIoTData?
  favorites      Favorite[]
  images         SpotImage[]
  reviews        Review[]
  itineraryItems ItineraryItem[]

  @@index([city])
  @@index([category])
  @@index([amapId])
}

// Spot IoT Data Table - IoT数据表
model SpotIoTData {
  id     String @id @default(cuid())
  spotId String @unique
  spot   Spot   @relation(fields: [spotId], references: [id], onDelete: Cascade)

  // IoT data
  crowdLevel      Float
  temperature     Float
  rainProbability Float
  isOpen          Boolean

  // Weather data (from OpenWeatherMap)
  weatherDescription String?   @default("")  // 天气状况中文描述
  weatherIcon       String?   @default("")  // 天气图标代码
  weatherUpdatedAt  DateTime? // 天气数据最后更新时间

  // Metadata
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([spotId])
  @@index([generatedAt])
}

// Spot Image Table - 景点图片表（完整版）
model SpotImage {
  id         String   @id @default(cuid())
  spotId     String
  spot       Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)

  // 图片信息
  url        String?  @default("") // 图片URL (可为空，用于迁移现有数据)
  source     String   @default("unsplash") // 'admin', 'user_upload', 'community', 'unsplash'
  status     String   @default("approved") // 'pending', 'approved', 'rejected' (默认approved用于现有数据)
  priority   Int      @default(1) // admin=10, user=5, unsplash=1
  isPrimary  Boolean  @default(false) // 是否为主图
  fileHash   String   @default("") // 文件hash，用于去重 (默认空字符串用于迁移)

  // 审核信息
  uploadedBy String   @default("system") // 上传者ID (默认system用于迁移)
  uploader   User     @relation("ImageUploader", fields: [uploadedBy], references: [id])
  reviewedBy String?
  reviewer   User?    @relation("ImageReviewer", fields: [reviewedBy], references: [id])
  reviewedAt DateTime?
  reviewNote String?

  // 统计信息
  viewCount  Int      @default(0)
  likeCount  Int      @default(0)
  reportCount Int     @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) // 使用默认值而非@updatedAt

  @@index([spotId])
  @@index([source])
  @@index([status])
  @@index([priority])
  @@index([uploadedBy])
  // 注意：唯一索引暂时移除，因为现有数据的fileHash都是空字符串
  // @@unique([spotId, fileHash]) // 防止同一景点上传重复图片
}

// Review Table - 评价表
model Review {
  id         String   @id @default(cuid())
  spotId     String
  spot       Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  userId     String   // 用户ID（暂时使用固定ID）
  rating     Float    // 评分 1-5
  comment    String?  // 评论内容
  likeCount  Int      @default(0) // 点赞数
  images     ReviewImage[] // 评论图片
  likes      ReviewLike[] // 点赞记录
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([spotId])
  @@index([userId])
  @@index([rating])
  @@index([likeCount])
}

// Review Image Table - 评价图片表
model ReviewImage {
  id       String @id @default(cuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  imageUrl String // 图片URL
  altText  String? // 图片描述
  createdAt DateTime @default(now())

  @@index([reviewId])
}

// Review Like Table - 评价点赞表
model ReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String   // 用户ID
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
}

// Spot Alternatives Table - 备选景点关系表
model SpotAlternative {
  id                String @id @default(cuid())
  originalSpotId    String // 原景点ID
  alternativeSpotId String // 备选景点ID
  city              String // 城市
  priority          Int    @default(0) // 优先级（用于排序）

  createdAt DateTime @default(now())

  @@unique([originalSpotId, alternativeSpotId])
  @@index([originalSpotId])
  @@index([alternativeSpotId])
  @@index([city])
}

// Favorites Table - 收藏表
model Favorite {
  id     String @id @default(cuid())
  spotId String // 景点ID
  spot   Spot   @relation(fields: [spotId], references: [id], onDelete: Cascade)

  // 用户标识（暂时使用固定ID，后续可以改为真实用户系统）
  userId String @default("default-user")

  // 收藏备注
  notes String? @default("")

  // 收藏时间
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spotId, userId])
  @@index([userId])
  @@index([spotId])
}

// Destination Cache Table - 目的地热门景点缓存表
model DestinationCache {
  id          String   @id @default(cuid())
  city        String   @unique // 城市名称
  attractions String // 景点列表JSON字符串
  expiresAt   DateTime // 过期时间
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([city])
  @@index([expiresAt])
}

// Blog Post Table - 博客文章表
model BlogPost {
  id          String   @id @default(cuid())
  userId      String   // 用户ID
  title       String   // 标题
  content     String   // 内容（富文本）
  coverImage  String?  // 封面图片
  tags        String   // 标签（逗号分隔）
  city        String?  // 相关城市
  spotIds     String?  // 相关景点ID（逗号分隔）
  imageIds    String?  // 图片ID列表（逗号分隔）
  viewCount   Int      @default(0) // 浏览量
  likeCount   Int      @default(0) // 点赞数
  commentCount Int     @default(0) // 评论数
  isPublished Boolean  @default(false) // 是否发布
  publishedAt DateTime? // 发布时间

  // 审核字段
  status      String   @default("pending") // 'pending', 'approved', 'rejected'
  reviewedBy  String?
  reviewer    User?    @relation("BlogReviewer", fields: [reviewedBy], references: [id])
  reviewedAt  DateTime?
  reviewNote  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  comments    BlogComment[]
  likes       BlogLike[]

  @@index([userId])
  @@index([city])
  @@index([isPublished])
  @@index([publishedAt])
  @@index([status])
}

// Blog Comment Table - 博客评论表
model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   // 用户ID
  content   String   // 评论内容
  likeCount Int      @default(0) // 点赞数
  likes     BlogCommentLike[] // 点赞记录
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([userId])
  @@index([createdAt])
  @@index([likeCount])
}

// Blog Comment Like Table - 博客评论点赞表
model BlogCommentLike {
  id        String   @id @default(cuid())
  commentId String
  comment   BlogComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String   // 用户ID
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

// Blog Like Table - 博客点赞表
model BlogLike {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   // 用户ID
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

// Hotel Table - 酒店表（永久存储）
model Hotel {
  id String @id @default(cuid())

  // 酒店基本信息
  amapId       String  @unique // 高德地图POI ID
  name         String
  address      String?
  location     String  // 经纬度 "116.397428,39.90923"
  tel          String?
  type         String  // 酒店类型/档次
  rating       Float?

  // 地理信息
  city         String  // 所属城市

  // 统计信息
  hitCount     Int     @default(0) // 使用次数

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([city])
  @@index([location])
}

// Restaurant Table - 餐厅表（永久存储）
model Restaurant {
  id String @id @default(cuid())

  // 餐厅基本信息
  amapId       String  @unique // 高德地图POI ID
  name         String
  address      String?
  location     String  // 经纬度 "116.397428,39.90923"
  tel          String?
  type         String  // 菜系/类型
  rating       Float?

  // 地理信息
  city         String  // 所属城市

  // 统计信息
  hitCount     Int     @default(0) // 使用次数

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([city])
  @@index([location])
}
